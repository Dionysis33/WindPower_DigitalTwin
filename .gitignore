# ---------------------------------------------------------
# THESIS-SAFE ARTIFACT POLICY
# ---------------------------------------------------------

# 1) Raw / interim data remain local-only
data/raw/**
!data/raw/.gitkeep
data/interim/**
!data/interim/.gitkeep

# 2) Processed outputs remain local-only by default,
#    except for the canonical tracked benchmark artifact
data/processed/**
!data/processed/
!data/processed/baseline_metrics.csv

# 3) Local-only model artifacts
models/local/**
!models/local/.gitkeep
models/*.h5
models/*.keras
models/*.joblib
models/*.pkl
models/*.pt
models/*.pth
models/*.ckpt
models/*.onnx

# 4) Selected thesis / report-facing figures under reports/figures/
#    stay trackable by default.
#    Do not use reports/figures/ as a notebook dump folder.