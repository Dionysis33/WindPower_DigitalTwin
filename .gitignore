# ---------------------------------------------------------
# LOCAL ARTIFACT POLICY
# ---------------------------------------------------------

# 1) Keep source and temporary data local-only
data/raw/**
!data/raw/
!data/raw/.gitkeep

data/interim/**
!data/interim/
!data/interim/.gitkeep

# 2) Keep generated outputs local-only by default,
#    except for selected tracked reference files and placeholders.
data/processed/**
!data/processed/
!data/processed/baseline_metrics.csv

# Local prediction outputs
!data/processed/predictions/
!data/processed/predictions/.gitkeep

# Local diagnostic outputs
!data/processed/diagnostics/
!data/processed/diagnostics/.gitkeep

# Local graph outputs
!data/processed/graph/
!data/processed/graph/.gitkeep

# 3) Keep local model artifacts out of version control
models/local/**
!models/local/
!models/local/.gitkeep

models/*.h5
models/*.keras
models/*.joblib
models/*.pkl
models/*.pt
models/*.pth
models/*.ckpt
models/*.onnx

# 4) Keep selected report figures trackable.
#    Avoid using this folder as a general dump location.

# ---------------------------------------------------------
# LOCAL-ONLY LITERATURE MATERIALS
# ---------------------------------------------------------
# Academic papers, PDFs, and reading notes used only as local research context.
# These files must stay outside GitHub.
literature_local/
